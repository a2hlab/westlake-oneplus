+static bool CaptureSetUpForReads(struct AlsaSoundCard *cardIns)
+{
+    snd_pcm_state_t state = snd_pcm_state(cardIns->pcmHandle);
+    if (state != SND_PCM_STATE_PREPARED && state != SND_PCM_STATE_RUNNING) {
+        return false;
+    }
+    snd_pcm_hw_params_t *current = NULL;
+    snd_pcm_access_t access;
+    snd_pcm_hw_params_alloca(&current);
+    return snd_pcm_hw_params_current(cardIns->pcmHandle, current) == 0 &&
+        snd_pcm_hw_params_get_access(current, &access) == 0 && access == SND_PCM_ACCESS_RW_INTERLEAVED;
+}
