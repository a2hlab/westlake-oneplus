--- a/fajita/hals/audio/BUILD.gn
+++ b/fajita/hals/audio/BUILD.gn
@@ -31,6 +31,32 @@ ohos_prebuilt_etc("hdf_audio_path_json") {
   part_name = "product_fajita"
 }
 
+ohos_prebuilt_etc("hdf_alsa_adapter_json") {
+  source = "alsa_adapter.json"
+  relative_install_dir = "hdfconfig"
+  install_images = [ chipset_base_dir ]
+  subsystem_name = "hdf"
+  part_name = "product_fajita"
+}
+
+# alsa-lib reads its configuration from /vendor/etc/audio/alsa/share (third_party/alsa-lib include/config.h) but
+# installs its files into the system image: the two it needs, on the vendor side
+ohos_prebuilt_etc("fajita_alsa_conf") {
+  source = "//third_party/alsa-lib/src/conf/alsa.conf"
+  relative_install_dir = "audio/alsa/share"
+  install_images = [ chipset_base_dir ]
+  subsystem_name = "hdf"
+  part_name = "product_fajita"
+}
+
+ohos_prebuilt_etc("fajita_alsa_smixer_conf") {
+  source = "//third_party/alsa-lib/src/conf/smixer.conf"
+  relative_install_dir = "audio/alsa/share"
+  install_images = [ chipset_base_dir ]
+  subsystem_name = "hdf"
+  part_name = "product_fajita"
+}
+
 ohos_prebuilt_etc("audio_policy_config") {
