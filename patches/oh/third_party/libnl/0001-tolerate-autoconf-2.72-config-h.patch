With autoconf 2.72 the generated include/config.h words its comments differently, so the config.h hunks of
solve-oh-compile-problem3_11_0.patch no longer apply (--fuzz=0) and install.sh aborts. Keep going and set the
three defines that the patch hunks would have set.

diff --git a/install.sh b/install.sh
index faaea07..8acf673 100755
--- a/install.sh
+++ b/install.sh
@@ -19,6 +19,11 @@ mv libnl-libnl3_11_0 libnl
 cd $1/libnl
 ./autogen.sh
 ./configure
-patch -p1 < $1/solve-oh-compile-problem3_11_0.patch --fuzz=0 --no-backup-if-mismatch
+patch -p1 < $1/solve-oh-compile-problem3_11_0.patch --fuzz=0 --no-backup-if-mismatch || true
+# autoconf 2.72 words config.h comments differently, so the patch's config.h hunks can miss; apply them directly
+sed -i -e 's/^#define HAVE_DECL_GETPROTOBYNAME_R 1$/#define HAVE_DECL_GETPROTOBYNAME_R 0/' \
+       -e 's/^#define HAVE_DECL_GETPROTOBYNUMBER_R 1$/#define HAVE_DECL_GETPROTOBYNUMBER_R 0/' \
+       -e 's/^#define HAVE_STRERROR_L 1$/#define HAVE_STRERROR_L 0/' include/config.h
+rm -f include/config.h.rej
 exit 0
 )180>test.lock
