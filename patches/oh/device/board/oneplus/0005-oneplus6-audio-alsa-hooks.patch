+/* OnePlus 6 capture hooks (OH 7.0 ALSA adapter): the main microphone, see common.h. Based on the rk3568 board's, with the hook
+ * signatures of OH 7.0's ALSA adapter (alsa_snd_capture.h). */
+
+#include "alsa_snd_capture.h"
+#include "common.h"
+
+#define HDF_LOG_TAG HDF_AUDIO_HAL_CAPTURE
+
+typedef struct _CAPTURE_DATA_ {
+    struct AlsaMixerCtlElement ctrlVolume;
+    long tempVolume;
+}CaptureData;
+
+/* WCD9340 main microphone (ADC3, decimator 0) to SLIMbus TX0, and SLIMBUS_0_TX into MultiMedia2 */
+static const struct {
+    const char *name;
+    const char *value;
+} g_micRoute[] = {
+    { "AIF1_CAP Mixer SLIM TX0", SND_SWITCH_ON },
+    { "CDC_IF TX0 MUX", "DEC0" },
+    { "ADC MUX0", "AMIC" },
+    { "AMIC MUX0", "ADC3" },
+    { "DEC0 Volume", "84" },
+    { SND_ELEM_MIC_ROUTE, SND_SWITCH_ON },
+};
+
+static void ElementByName(struct AlsaMixerCtlElement *elem, const char *name, const char *value)
+{
+    SndElementItemInit(elem);
+    elem->numid = 0;   /* look the element up by name */
+    elem->name = name;
+    elem->value = (char *)value;
+}
+
+static int32_t WriteElement(struct AlsaSoundCard *cardIns, const char *name, const char *value)
+{
+    struct AlsaMixerCtlElement elem;
+    ElementByName(&elem, name, value);
+    int32_t ret = SndElementWrite(cardIns, &elem);
+    if (ret != HDF_SUCCESS) {
+        AUDIO_FUNC_LOGE("write %{public}s = %{public}s failed", name, value);
+    }
+    return ret;
+}
+
+static int32_t CaptureRoute(struct AlsaCapture *captureIns)
+{
+    int32_t ret = HDF_SUCCESS;
+    for (size_t i = 0; i < sizeof(g_micRoute) / sizeof(g_micRoute[0]); i++) {
+        if (WriteElement(&captureIns->soundCard, g_micRoute[i].name, g_micRoute[i].value) != HDF_SUCCESS) {
+            ret = HDF_FAILURE;
+        }
+    }
+    return ret;
+}
+
+static int32_t CaptureInitImpl(struct AlsaCapture *captureIns)
+{
+    CHECK_NULL_PTR_RETURN_DEFAULT(captureIns);
+    /* the route goes in before the adapter's snd_pcm_hw_params, which also prepares the stream: a front end with
+     * no route fails prepare ("ASoC: no backend DAIs enabled for MultiMedia1"). It stays on: DAPM powers the path
+     * only while a stream runs */
+    (void)CaptureRoute(captureIns);
+    /* The adapter reads one ALSA period per call, and the HDI fails a read that is larger than the caller's buffer.
+     * audio_server reads 40 ms at a time and the adapter's default period is 100 ms (capped at 16 KB), so every
+     * read failed. 20 ms periods: audio_server collects two per read. */
+    captureIns->periodTime = SND_CAPTURE_PERIOD_US;
+    captureIns->bufferTime = SND_CAPTURE_BUFFER_US;
+    if (captureIns->priData != NULL) {
+        return HDF_SUCCESS;
+    }
+    CaptureData *priData = (CaptureData *)OsalMemCalloc(sizeof(CaptureData));
+    if (priData == NULL) {
+        AUDIO_FUNC_LOGE("Failed to allocate memory!");
+        return HDF_FAILURE;
+    }
+    ElementByName(&priData->ctrlVolume, SND_ELEM_MIC_VOL, NULL);
+    CaptureSetPriData(captureIns, (CapturePriData)priData);
+    (void)WriteElement((struct AlsaSoundCard *)captureIns, SND_ELEM_MIC_VOL, SND_MIC_VOL_DEFAULT);
+    return HDF_SUCCESS;
+}
+
+static int32_t CaptureSelectSceneImpl(struct AlsaCapture *captureIns, const struct AudioHwCaptureParam *handleData)
+{
+    CHECK_NULL_PTR_RETURN_DEFAULT(captureIns);
+    CHECK_NULL_PTR_RETURN_DEFAULT(handleData);
+    captureIns->descPins = handleData->captureMode.hwInfo.deviceDescript.pins;
+    return HDF_SUCCESS;
+}
+
+static int32_t CaptureGetVolThresholdImpl(struct AlsaCapture *captureIns, long *volMin, long *volMax)
+{
+    long min = 0;
+    long max = 0;
+    struct AlsaSoundCard *cardIns = (struct AlsaSoundCard *)captureIns;
+    CaptureData *priData = CaptureGetPriData(captureIns);
+    CHECK_NULL_PTR_RETURN_DEFAULT(cardIns);
+    CHECK_NULL_PTR_RETURN_DEFAULT(priData);
+    if (SndElementReadRange(cardIns, &priData->ctrlVolume, &min, &max) != HDF_SUCCESS) {
+        AUDIO_FUNC_LOGE("SndElementReadRange fail!");
+        return HDF_FAILURE;
+    }
+    *volMin = min;
+    *volMax = max;
+    return HDF_SUCCESS;
+}
+
+static int32_t CaptureGetVolumeImpl(struct AlsaCapture *captureIns, long *volume)
+{
+    long vol = 0;
+    struct AlsaSoundCard *cardIns = (struct AlsaSoundCard *)captureIns;
+    CaptureData *priData = CaptureGetPriData(captureIns);
+    CHECK_NULL_PTR_RETURN_DEFAULT(cardIns);
+    CHECK_NULL_PTR_RETURN_DEFAULT(priData);
+    if (SndElementReadInt(cardIns, &priData->ctrlVolume, &vol) != HDF_SUCCESS) {
+        AUDIO_FUNC_LOGE("Read volume fail!");
+        return HDF_FAILURE;
+    }
+    *volume = vol;
+    return HDF_SUCCESS;
+}
+
+static int32_t CaptureSetVolumeImpl(struct AlsaCapture *captureIns, long volume)
+{
+    struct AlsaSoundCard *cardIns = (struct AlsaSoundCard *)captureIns;
+    CaptureData *priData = CaptureGetPriData(captureIns);
+    CHECK_NULL_PTR_RETURN_DEFAULT(cardIns);
+    CHECK_NULL_PTR_RETURN_DEFAULT(priData);
+    if (SndElementWriteInt(cardIns, &priData->ctrlVolume, volume) != HDF_SUCCESS) {
+        AUDIO_FUNC_LOGE("Write volume fail!");
+        return HDF_FAILURE;
+    }
+    return HDF_SUCCESS;
+}
+
+static bool CaptureGetMuteImpl(struct AlsaCapture *captureIns)
+{
+    return captureIns->muteState;
+}
+
+static int32_t CaptureSetMuteImpl(struct AlsaCapture *captureIns, bool muteFlag)
+{
+    long vol = 0;
+    CaptureData *priData = CaptureGetPriData(captureIns);
+    CHECK_NULL_PTR_RETURN_DEFAULT(captureIns);
+    CHECK_NULL_PTR_RETURN_DEFAULT(priData);
+    if (captureIns->GetVolume(captureIns, &vol) != HDF_SUCCESS) {
+        AUDIO_FUNC_LOGE("GetVolume failed!");
+        return HDF_FAILURE;
+    }
+    long setVol;
+    if (muteFlag) {
+        priData->tempVolume = vol;
+        setVol = 0;
+    } else {
+        setVol = priData->tempVolume;
+    }
+    if (captureIns->SetVolume(captureIns, setVol) != HDF_SUCCESS) {
+        AUDIO_FUNC_LOGE("SetVolume failed!");
+        return HDF_FAILURE;
+    }
+    captureIns->muteState = muteFlag;
+    return HDF_SUCCESS;
+}
+
+static int32_t CaptureStartImpl(struct AlsaCapture *captureIns, const struct AudioHwCaptureParam *handleData)
+{
+    (void)handleData;
+    CHECK_NULL_PTR_RETURN_DEFAULT(captureIns);
+    return CaptureRoute(captureIns);
+}
+
+static int32_t CaptureStopImpl(struct AlsaCapture *captureIns)
+{
+    CHECK_NULL_PTR_RETURN_DEFAULT(captureIns);
+    CHECK_NULL_PTR_RETURN_DEFAULT(captureIns->soundCard.pcmHandle);
+    snd_pcm_drop(captureIns->soundCard.pcmHandle);
+    return HDF_SUCCESS;
+}
+
+static int32_t CaptureGetGainThresholdImpl(struct AlsaCapture *captureIns, float *gainMin, float *gainMax)
+{
+    AUDIO_FUNC_LOGI("Not support gain operation");
+    return HDF_SUCCESS;
+}
+
+static int32_t CaptureGetGainImpl(struct AlsaCapture *captureIns, float *volume)
+{
+    AUDIO_FUNC_LOGI("Not support gain operation");
+    return HDF_SUCCESS;
+}
+
+static int32_t CaptureSetGainImpl(struct AlsaCapture *captureIns, float volume)
+{
+    AUDIO_FUNC_LOGI("Not support gain operation");
+    return HDF_SUCCESS;
+}
+
+int32_t CaptureOverrideFunc(struct AlsaCapture *captureIns)
+{
+    if (captureIns == NULL) {
+        return HDF_FAILURE;
+    }
+    struct AlsaSoundCard *cardIns = (struct AlsaSoundCard *)captureIns;
+    if (cardIns->cardType == SND_CARD_PRIMARY) {
+        captureIns->Init = CaptureInitImpl;
+        captureIns->SelectScene = CaptureSelectSceneImpl;
+        captureIns->Start = CaptureStartImpl;
+        captureIns->Stop = CaptureStopImpl;
+        captureIns->GetVolThreshold = CaptureGetVolThresholdImpl;
+        captureIns->GetVolume = CaptureGetVolumeImpl;
+        captureIns->SetVolume = CaptureSetVolumeImpl;
+        captureIns->GetGainThreshold = CaptureGetGainThresholdImpl;
+        captureIns->GetGain = CaptureGetGainImpl;
+        captureIns->SetGain = CaptureSetGainImpl;
+        captureIns->GetMute = CaptureGetMuteImpl;
+        captureIns->SetMute = CaptureSetMuteImpl;
+    }
+    return HDF_SUCCESS;
+}
+
+/* PCM device for a scene: MultiMedia2 for all (see common.h); this phone has no voice-call path */
+int32_t CaptureGetSceneDev(enum AudioCategory scene)
+{
+    (void)scene;
+    return SND_CAPTURE_PCM_DEV_BEFORE;
+}
