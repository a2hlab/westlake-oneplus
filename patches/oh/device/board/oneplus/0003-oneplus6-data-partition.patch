diff --git a/fajita/cfg/mount-data.sh b/fajita/cfg/mount-data.sh
new file mode 100644
index 0000000..9475e75
--- /dev/null
+++ b/fajita/cfg/mount-data.sh
@@ -0,0 +1,36 @@
+#!/system/bin/sh
+# /data for OpenHarmony on a OnePlus 6. init runs this with syncexec at the start of the vendor pre-init job.
+# With a GPT partition named "ohdata" (westlake-oneplus scripts/13-data-partition.sh makes one from the end of
+# Android's userdata), /data is that partition (ext4) and survives reboots. Without one, or when it cannot be
+# mounted, /data is a 4 GB RAM disk as before, and everything on it is lost at the next boot.
+PATH=/system/bin:/bin
+log() { echo "mount-data: $*" > /dev/kmsg; }
+dev=
+for u in /sys/class/block/*/uevent; do
+    grep -qx 'PARTNAME=ohdata' "$u" 2>/dev/null || continue
+    d=${u%/uevent}
+    dev=/dev/block/${d##*/}
+    # this early, ueventd may not have made the node yet
+    if [ ! -b "$dev" ]; then
+        mm=$(cat "$d/dev")
+        mknod "$dev" b "${mm%%:*}" "${mm##*:}"
+    fi
+    break
+done
+if [ -n "$dev" ]; then
+    # 0: clean, 1 or 2: fixed. 4 and up: errors were left for a person to answer; there is nobody to ask, so
+    # let e2fsck fix them all (this is a test phone's data, and the alternative is an unusable /data)
+    out=$(e2fsck -p "$dev" 2>&1)
+    rc=$?
+    if [ "$rc" -ge 4 ]; then
+        log "e2fsck -p left errors ($rc): $(echo "$out" | head -n 1); running e2fsck -y"
+        out=$(e2fsck -y "$dev" 2>&1)
+        rc=$?
+    fi
+    if mount -t ext4 -o nosuid,nodev,noatime "$dev" /data; then
+        log "/data is $dev (e2fsck $rc: $(echo "$out" | tail -n 1))"
+        exit 0
+    fi
+    log "could not mount $dev (e2fsck $rc); /data is a RAM disk"
+fi
+mount -t tmpfs -o nosuid,nodev,noatime,mode=0771,size=4g tmpfs /data
