diff --git a/fajita/cfg/logdump.sh b/fajita/cfg/logdump.sh
new file mode 100644
index 0000000..c263a1a
--- /dev/null
+++ b/fajita/cfg/logdump.sh
@@ -0,0 +1,28 @@
+#!/system/bin/sh
+# Optional bring-up log channel for the OnePlus 6 (enchilada). Off unless the kernel command line has
+# op6.logdump=1. Every 4 s it writes the kernel log, process list and mounts to the unused space at the
+# end of system_b (/dev/block/sda14, past the 2.5 GiB OH system image), where Android (slot A, root) can
+# read it back after a hang:  dd if=/dev/block/by-name/system_b bs=4096 skip=655360 count=1024
+grep -q "op6.logdump=1" /proc/cmdline || exit 0
+DEV=/dev/block/sda14
+OFF=655360                      # 4 KiB blocks = 2684354560 bytes, the OH system image size
+SIZE=$(cat /sys/class/block/sda14/size 2>/dev/null)
+[ "$SIZE" = "5857280" ] || exit 0   # 512-byte sectors of the OnePlus 6 system_b; anything else: do nothing
+dd if=/dev/zero of=$DEV bs=4096 seek=$OFF count=1024 conv=notrunc 2>/dev/null
+n=0
+while [ $n -lt 2000 ]; do
+  {
+    echo "=== LOGDUMP n=$n uptime=$(cat /proc/uptime)"
+    dmesg
+    echo "=== PS"; ps -ef
+    echo "=== MOUNTS"; cat /proc/mounts
+    echo "=== FAULTLOG"; ls -l /data/log/faultlog/temp 2>&1 | tail -n 30
+    for f in $(ls -t /data/log/faultlog/temp/cppcrash-* 2>/dev/null | head -n 6); do echo "--- $f"; head -n 60 $f; done
+    echo "=== USB"; ls /sys/class/udc 2>&1; cat /config/usb_gadget/g1/UDC 2>&1
+    echo "=== END n=$n"
+  } > /dev/logdump.txt 2>&1
+  dd if=/dev/logdump.txt of=$DEV bs=4096 seek=$OFF count=1024 conv=notrunc 2>/dev/null
+  sync
+  n=$((n+1))
+  sleep 4
+done
