Build-order fix for the sdm845 display HDI libraries. Their sources include OH 6.1's composer interface
headers (v1_3 -> v1_2 -> v1_1) and the v1_2 buffer types. Those headers are generated by the
drivers_interface_display IDL targets of each version, but the libraries depended only on the v1_0
header groups. An incremental tree already has the headers; a clean parallel build can compile before
they exist and fails with "'v1_2/display_composer_type.h' file not found". Depend on the header-only
groups of those versions. This links no extra libraries: the groups bring only libraries these targets
already use.

diff --git a/sdm845/hardware/display/BUILD.gn b/sdm845/hardware/display/BUILD.gn
index e9aadee..8ecc4de 100644
--- a/sdm845/hardware/display/BUILD.gn
+++ b/sdm845/hardware/display/BUILD.gn
@@ -50,6 +50,7 @@ ohos_shared_library("libdisplay_buffer_vdi_impl") {
   external_deps = [
     "c_utils:utils",
     "drivers_interface_display:display_buffer_idl_headers",
+    "drivers_interface_display:display_buffer_idl_headers_1.2",
     "drivers_interface_display:display_composer_idl_headers",
     "hdf_core:libhdf_utils",
     "hilog:libhilog",
@@ -139,6 +140,9 @@ ohos_shared_library("libdisplay_composer_vdi_impl") {
   external_deps = [
     "c_utils:utils",
     "drivers_interface_display:display_composer_idl_headers",
+    "drivers_interface_display:display_composer_idl_headers_1.1",
+    "drivers_interface_display:display_composer_idl_headers_1.2",
+    "drivers_interface_display:display_composer_idl_headers_1.3",
     "graphic_surface:buffer_handle",
     "hilog:libhilog",
     "ipc:ipc_single",
@@ -206,6 +210,7 @@ ohos_shared_library("display_composer_vendor") {
   external_deps = [
     "c_utils:utils",
     "drivers_interface_display:display_buffer_idl_headers",
+    "drivers_interface_display:display_buffer_idl_headers_1.2",
     "drivers_interface_display:display_composer_idl_headers",
     "hdf_core:libhdf_utils",
     "hilog:libhilog",
