+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OnePlus 6 / 6T cameras on the 5.10 sdm845 kernel: the SDM845 camera
+ * subsystem (CAMSS), the camera I2C controller (CCI) and the three sensors
+ * with their supplies, clocks and pins.
+ *
+ * From the sdm845-mainline tree (codeberg.org/sdm845/linux, sdm845-next:
+ * the sdm845.dtsi CAMSS node and the sdm845-oneplus-common.dtsi camera
+ * nodes), adapted to this kernel: the CAMSS node is added here instead of in
+ * sdm845.dtsi, LVS1 is added to this tree's PM8998 regulators, and the MCLK
+ * pin states this tree's sdm845.dtsi lacks are defined here.
+ *
+ *   CSIPHY0 <- IMX519  rear main      (CCI0 0x1a, MCLK0, C-PHY 3 trios)
+ *   CSIPHY1 <- IMX376K rear secondary (CCI1 0x10, MCLK2, D-PHY 4 lanes)
+ *   CSIPHY2 <- IMX371  front          (CCI0 0x10, MCLK1, D-PHY 4 lanes)
+ */
+
