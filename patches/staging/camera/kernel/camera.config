# Cameras (staged kernel patches 0008-0010): the SDM845 camera subsystem, the OnePlus 6 sensors and lens drivers. All
# modules, so the built-in kernel (and with it every module ABI) stays the same as without them.
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_IMX371=m
CONFIG_VIDEO_IMX376=m
CONFIG_VIDEO_IMX519=m
CONFIG_VIDEO_LC89821X=m
