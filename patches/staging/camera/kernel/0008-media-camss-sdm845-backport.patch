+/*
+ * camss_link_sensor - Link a bound sensor to its CSIPHY
+ *
+ * Backport note: upstream creates these links (and the subdev device nodes)
+ * only in .complete, i.e. once every sensor in the device tree has bound. The
+ * OnePlus 6 has three sensors with separate drivers; doing it per sensor in
+ * .bound makes each camera usable even if another one fails to probe.
+ */
+static int camss_link_sensor(struct camss *camss, struct v4l2_subdev *sd)
+{
+	struct csiphy_device *csiphy = sd->host_priv;
+	struct media_entity *input, *sensor;
+	unsigned int i;
+	int ret;
+
+	if (!csiphy)
+		return 0;
+
+	input = &csiphy->subdev.entity;
+	sensor = &sd->entity;
+
+	for (i = 0; i < sensor->num_pads; i++) {
+		if (sensor->pads[i].flags & MEDIA_PAD_FL_SOURCE)
+			break;
+	}
+	if (i == sensor->num_pads) {
+		dev_err(camss->dev,
+			"No source pad in external entity\n");
+		return -EINVAL;
+	}
+
+	ret = media_create_pad_link(sensor, i, input,
+				    MSM_CSIPHY_PAD_SINK,
+				    MEDIA_LNK_FL_IMMUTABLE | MEDIA_LNK_FL_ENABLED);
+	if (ret < 0) {
+		camss_link_err(camss, sensor->name, input->name, ret);
+		return ret;
+	}
+
+	return 0;
+}
