+/*
+ * Bring-up aid (not upstream): upstream does not enable the GCC camera AXI
+ * branch for SDM845 CAMSS. If the VFE write masters stall on this kernel,
+ * loading with enable_gcc_axi=1 keeps it on while CAMSS is bound.
+ */
+static bool enable_gcc_axi;
+module_param(enable_gcc_axi, bool, 0444);
+MODULE_PARM_DESC(enable_gcc_axi,
+		 "Keep the gcc_camera_axi clock on while CAMSS is bound (bring-up aid)");
+
+static void camss_gcc_axi_on(struct camss *camss)
+{
+	struct clk *clk;
+
+	if (!enable_gcc_axi)
+		return;
+
+	clk = devm_clk_get(camss->dev, "gcc_camera_axi");
+	if (IS_ERR(clk) || clk_prepare_enable(clk)) {
+		dev_warn(camss->dev, "gcc_camera_axi clock not enabled\n");
+		return;
+	}
+
+	camss->gcc_axi = clk;
+	dev_info(camss->dev, "gcc_camera_axi clock kept on\n");
+}
+
+static void camss_gcc_axi_off(struct camss *camss)
+{
+	if (camss->gcc_axi)
+		clk_disable_unprepare(camss->gcc_axi);
+	camss->gcc_axi = NULL;
+}
