diff --git a/drivers/media/platform/qcom/camss/camss-compat.h b/drivers/media/platform/qcom/camss/camss-compat.h
new file mode 100644
index 000000000..a1c10b2dc
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-compat.h
@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * camss-compat.h
+ *
+ * Linux 5.10 compatibility for the CAMSS driver backported from a 7.x
+ * kernel (sdm845 only). The driver code keeps the newer names; this header
+ * maps them onto the 5.10 media core.
+ */
+#ifndef QC_MSM_CAMSS_COMPAT_H
+#define QC_MSM_CAMSS_COMPAT_H
+
+#include <linux/kernel.h>
+#include <media/media-entity.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+
+/* v5.14: the per-file-handle pad configuration became struct v4l2_subdev_state */
+#define v4l2_subdev_state v4l2_subdev_pad_config
+
+static inline struct v4l2_mbus_framefmt *
+v4l2_subdev_state_get_format(struct v4l2_subdev_pad_config *cfg,
+			     unsigned int pad)
+{
+	return &cfg[pad].try_fmt;
+}
+
+static inline struct v4l2_rect *
+v4l2_subdev_state_get_crop(struct v4l2_subdev_pad_config *cfg,
+			   unsigned int pad)
+{
+	return &cfg[pad].try_crop;
+}
+
+static inline struct v4l2_rect *
+v4l2_subdev_state_get_compose(struct v4l2_subdev_pad_config *cfg,
+			      unsigned int pad)
+{
+	return &cfg[pad].try_compose;
+}
+
+/* v5.19: media_entity_remote_pad() was renamed */
+#define media_pad_remote_pad_first media_entity_remote_pad
+
+/* v5.18: the CSI-2 bus configuration moved and was renamed */
+#define v4l2_mbus_config_mipi_csi2 v4l2_fwnode_bus_mipi_csi2
+
+/* v6.5: struct v4l2_async_subdev became struct v4l2_async_connection */
+#define v4l2_async_connection v4l2_async_subdev
+
+/* v5.16 / v6.5: the async notifier functions were renamed */
+#define v4l2_async_nf_unregister v4l2_async_notifier_unregister
+#define v4l2_async_nf_cleanup v4l2_async_notifier_cleanup
+
+#define v4l2_async_nf_add_fwnode_remote(notifier, ep, type)		\
+	((type *)v4l2_async_notifier_add_fwnode_remote_subdev(notifier, ep, \
+							       sizeof(type)))
+
+/*
+ * v5.11: v4l2_get_link_freq(); v6.14 takes the sensor's source pad. This is
+ * the 5.11 implementation, on the sensor subdev's control handler.
+ */
+static inline s64 camss_v4l2_get_link_freq(struct media_pad *pad,
+					   unsigned int mul, unsigned int div)
+{
+	struct v4l2_subdev *sd = media_entity_to_v4l2_subdev(pad->entity);
+	struct v4l2_ctrl *ctrl;
+	s64 freq;
+
+	ctrl = v4l2_ctrl_find(sd->ctrl_handler, V4L2_CID_LINK_FREQ);
+	if (ctrl) {
+		struct v4l2_querymenu qm = { .id = V4L2_CID_LINK_FREQ };
+		int ret;
+
+		qm.index = v4l2_ctrl_g_ctrl(ctrl);
+
+		ret = v4l2_querymenu(sd->ctrl_handler, &qm);
+		if (ret)
+			return -ENOENT;
+
+		freq = qm.value;
+	} else {
+		if (!mul || !div)
+			return -ENOENT;
+
+		ctrl = v4l2_ctrl_find(sd->ctrl_handler, V4L2_CID_PIXEL_RATE);
+		if (!ctrl)
+			return -ENOENT;
+
+		freq = div_u64(v4l2_ctrl_g_ctrl_int64(ctrl) * mul, div);
+	}
+
+	return freq > 0 ? freq : -EINVAL;
+}
+
+#define v4l2_get_link_freq camss_v4l2_get_link_freq
+
+/*
+ * v6.1: struct regulator_bulk_data gained init_load_uA, v6.3:
+ * devm_regulator_bulk_get_const(). The resource tables use this struct.
+ */
+struct camss_regulator {
+	const char *supply;
+	int init_load_uA;
+};
+
+static inline int
+camss_devm_regulator_bulk_get_const(struct device *dev, int num,
+				    const struct camss_regulator *in,
+				    struct regulator_bulk_data **out)
+{
+	struct regulator_bulk_data *bulk;
+	int i, ret;
+
+	bulk = devm_kcalloc(dev, num ? num : 1, sizeof(*bulk), GFP_KERNEL);
+	if (!bulk)
+		return -ENOMEM;
+
+	for (i = 0; i < num; i++)
+		bulk[i].supply = in[i].supply;
+
+	ret = devm_regulator_bulk_get(dev, num, bulk);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < num; i++) {
+		if (in[i].init_load_uA <= 0)
+			continue;
+		ret = regulator_set_load(bulk[i].consumer, in[i].init_load_uA);
+		if (ret)
+			return ret;
+	}
+
+	*out = bulk;
+
+	return 0;
+}
+
+#define devm_regulator_bulk_get_const camss_devm_regulator_bulk_get_const
+
+#endif /* QC_MSM_CAMSS_COMPAT_H */
