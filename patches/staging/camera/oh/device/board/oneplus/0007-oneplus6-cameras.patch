diff --git a/fajita/camera/camss_setup/camss_setup.c b/fajita/camera/camss_setup/camss_setup.c
new file mode 100644
index 0000000000000000000000000000000000000000..45a1d7af1924c6fc3a9ff57021d915dcae29b3f8
--- /dev/null
+++ b/fajita/camera/camss_setup/camss_setup.c
@@ -0,0 +1,279 @@
+/*
+ * Copyright (c) 2026 OnePlus 6 OpenHarmony port.
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * camss_setup: configure the Qualcomm CAMSS media graph for one raw camera, once, at boot
+ * (what "media-ctl -l ... -V ..." does, without shipping media-ctl).
+ *
+ *   camss_setup SENSOR CSIPHY CSID VFE RDI [WAIT_S]
+ *   e.g. camss_setup imx376 1 0 0 0     OnePlus 6 rear IMX376K: msm_csiphy1 -> msm_csid0 -> msm_vfe0_rdi0
+ *
+ * Waits up to WAIT_S seconds (default 15) for the sensor entity ("SENSOR <bus>-<addr>") to appear in the
+ * CAMSS media device (it appears when the sensor driver binds), enables the links
+ * msm_csiphyN:1 -> msm_csidM:0 and msm_csidM:(1+RDI) -> msm_vfeK_rdiRDI:0, and sets the sensor's current
+ * format (code and size, so the Bayer order follows its flip controls) on the sink pads of the CSIPHY,
+ * CSID and VFE line. Prints the capture node (msm_vfeK_videoRDI). Exit 0 on success.
+ */
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <time.h>
+#include <unistd.h>
+#include <linux/media.h>
+#include <linux/v4l2-subdev.h>
+
+#define MAX_ENTITIES 128
+
+struct ent {
+	unsigned int id;
+	char name[32];
+	unsigned int major, minor;
+};
+
+static struct ent ents[MAX_ENTITIES];
+static int n_ents;
+
+static void logk(const char *fmt, const char *a, const char *b)
+{
+	char line[256];
+	int fd;
+
+	snprintf(line, sizeof(line), fmt, a ? a : "", b ? b : "");
+	fprintf(stderr, "camss_setup: %s\n", line);
+	fd = open("/dev/kmsg", O_WRONLY | O_CLOEXEC);
+	if (fd >= 0) {
+		dprintf(fd, "camss_setup: %s\n", line);
+		close(fd);
+	}
+}
+
+static int open_camss(void)
+{
+	char path[32];
+	int i, fd;
+
+	for (i = 0; i < 16; i++) {
+		struct media_device_info info;
+
+		snprintf(path, sizeof(path), "/dev/media%d", i);
+		fd = open(path, O_RDWR | O_CLOEXEC);
+		if (fd < 0)
+			continue;
+		memset(&info, 0, sizeof(info));
+		if (ioctl(fd, MEDIA_IOC_DEVICE_INFO, &info) == 0 &&
+		    strcmp(info.driver, "qcom-camss") == 0)
+			return fd;
+		close(fd);
+	}
+	return -1;
+}
+
+static int load_entities(int fd)
+{
+	struct media_entity_desc d;
+
+	n_ents = 0;
+	memset(&d, 0, sizeof(d));
+	d.id = MEDIA_ENT_ID_FLAG_NEXT;
+	while (n_ents < MAX_ENTITIES && ioctl(fd, MEDIA_IOC_ENUM_ENTITIES, &d) == 0) {
+		struct ent *e = &ents[n_ents++];
+
+		e->id = d.id;
+		snprintf(e->name, sizeof(e->name), "%s", d.name);
+		e->major = d.dev.major;
+		e->minor = d.dev.minor;
+		d.id |= MEDIA_ENT_ID_FLAG_NEXT;
+	}
+	return n_ents;
+}
+
+static struct ent *find_exact(const char *name)
+{
+	int i;
+
+	for (i = 0; i < n_ents; i++)
+		if (strcmp(ents[i].name, name) == 0)
+			return &ents[i];
+	return NULL;
+}
+
+static struct ent *find_sensor(const char *prefix)
+{
+	size_t n = strlen(prefix);
+	int i;
+
+	for (i = 0; i < n_ents; i++)
+		if (strncmp(ents[i].name, prefix, n) == 0 && ents[i].name[n] == ' ')
+			return &ents[i];
+	return NULL;
+}
+
+/* the /dev node of an entity, from its char device number */
+static int devnode(const struct ent *e, char *out, size_t len)
+{
+	DIR *dir = opendir("/dev");
+	struct dirent *de;
+	int found = -1;
+
+	if (!dir)
+		return -1;
+	while ((de = readdir(dir)) != NULL) {
+		char p[300];
+		struct stat st;
+
+		if (strncmp(de->d_name, "v4l-subdev", 10) && strncmp(de->d_name, "video", 5))
+			continue;
+		snprintf(p, sizeof(p), "/dev/%s", de->d_name);
+		if (stat(p, &st) == 0 && S_ISCHR(st.st_mode) &&
+		    major(st.st_rdev) == e->major && minor(st.st_rdev) == e->minor) {
+			snprintf(out, len, "%s", p);
+			found = 0;
+			break;
+		}
+	}
+	closedir(dir);
+	return found;
+}
+
+static int setup_link(int fd, const struct ent *src, int src_pad, const struct ent *sink, int sink_pad)
+{
+	struct media_link_desc l;
+
+	memset(&l, 0, sizeof(l));
+	l.source.entity = src->id;
+	l.source.index = src_pad;
+	l.sink.entity = sink->id;
+	l.sink.index = sink_pad;
+	l.flags = MEDIA_LNK_FL_ENABLED;
+	if (ioctl(fd, MEDIA_IOC_SETUP_LINK, &l) < 0) {
+		logk("link %s -> %s failed", src->name, sink->name);
+		return -1;
+	}
+	return 0;
+}
+
+static int subdev_fmt(const struct ent *e, int pad, struct v4l2_mbus_framefmt *fmt, int set)
+{
+	struct v4l2_subdev_format f;
+	char node[64];
+	int fd, ret;
+
+	if (devnode(e, node, sizeof(node)) < 0) {
+		logk("no device node for %s%s", e->name, NULL);
+		return -1;
+	}
+	fd = open(node, O_RDWR | O_CLOEXEC);
+	if (fd < 0) {
+		logk("cannot open %s (%s)", node, strerror(errno));
+		return -1;
+	}
+	memset(&f, 0, sizeof(f));
+	f.which = V4L2_SUBDEV_FORMAT_ACTIVE;
+	f.pad = pad;
+	if (set)
+		f.format = *fmt;
+	ret = ioctl(fd, set ? VIDIOC_SUBDEV_S_FMT : VIDIOC_SUBDEV_G_FMT, &f);
+	close(fd);
+	if (ret < 0) {
+		logk("%s format on %s failed", set ? "set" : "get", e->name);
+		return -1;
+	}
+	if (set && (f.format.code != fmt->code || f.format.width != fmt->width ||
+		    f.format.height != fmt->height)) {
+		logk("%s changed the format%s", e->name, NULL);
+		return -1;
+	}
+	*fmt = f.format;
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	char name[32], node[64], msg[128];
+	struct ent *sensor = NULL, *phy, *csid, *rdi, *vid;
+	struct v4l2_mbus_framefmt fmt;
+	int fd, waited, wait_s;
+	int nphy, ncsid, nvfe, nrdi;
+
+	if (argc < 6) {
+		fprintf(stderr, "usage: %s SENSOR CSIPHY CSID VFE RDI [WAIT_S]\n", argv[0]);
+		return 2;
+	}
+	nphy = atoi(argv[2]);
+	ncsid = atoi(argv[3]);
+	nvfe = atoi(argv[4]);
+	nrdi = atoi(argv[5]);
+	wait_s = argc > 6 ? atoi(argv[6]) : 15;
+
+	/* the entity appears when the sensor binds, its /dev node (ueventd) shortly after */
+	for (waited = 0; ; waited++) {
+		int have_media;
+
+		fd = open_camss();
+		have_media = fd >= 0;
+		if (have_media) {
+			load_entities(fd);
+			sensor = find_sensor(argv[1]);
+			if (sensor && devnode(sensor, node, sizeof(node)) == 0)
+				break;
+			close(fd);
+		}
+		if (waited >= wait_s * 10) {
+			logk(have_media ? "no %s sensor (entity and device node) in the CAMSS media graph" :
+					  "no qcom-camss media device (waiting for %s)", argv[1], NULL);
+			return 1;
+		}
+		usleep(100000);
+	}
+
+	snprintf(name, sizeof(name), "msm_csiphy%d", nphy);
+	phy = find_exact(name);
+	snprintf(name, sizeof(name), "msm_csid%d", ncsid);
+	csid = find_exact(name);
+	snprintf(name, sizeof(name), "msm_vfe%d_rdi%d", nvfe, nrdi);
+	rdi = find_exact(name);
+	snprintf(name, sizeof(name), "msm_vfe%d_video%d", nvfe, nrdi);
+	vid = find_exact(name);
+	if (!phy || !csid || !rdi || !vid) {
+		logk("CAMSS entities missing (csiphy/csid/vfe/video)%s%s", NULL, NULL);
+		return 1;
+	}
+
+	/* the sensor -> CSIPHY link is immutable; enable CSIPHY -> CSID -> VFE line */
+	if (setup_link(fd, phy, 1, csid, 0) < 0 || setup_link(fd, csid, 1 + nrdi, rdi, 0) < 0)
+		return 1;
+
+	memset(&fmt, 0, sizeof(fmt));
+	if (subdev_fmt(sensor, 0, &fmt, 0) < 0)
+		return 1;
+	fmt.field = V4L2_FIELD_NONE;
+	if (subdev_fmt(phy, 0, &fmt, 1) < 0 || subdev_fmt(csid, 0, &fmt, 1) < 0 ||
+	    subdev_fmt(rdi, 0, &fmt, 1) < 0)
+		return 1;
+
+	if (devnode(vid, node, sizeof(node)) < 0)
+		snprintf(node, sizeof(node), "(no node)");
+	snprintf(msg, sizeof(msg), "code 0x%04x %ux%u -> %s", fmt.code, fmt.width, fmt.height, node);
+	logk("%s: %s", sensor->name, msg);
+	printf("%s\n", node);
+	close(fd);
+	return 0;
+}
