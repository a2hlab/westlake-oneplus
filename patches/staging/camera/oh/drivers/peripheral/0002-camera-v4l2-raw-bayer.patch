+namespace OHOS::Camera {
+namespace CamssRaw {
+constexpr const char *CONFIG_PATH = "/vendor/etc/camera/camss_raw.cfg";
+constexpr uint32_t AE_PERIOD = 4; // frames between sensor exposure updates (sensor latency ~2)
+
+struct Entry {
+    std::string hw;
+    std::string video;
+    std::string sensor;
+    std::string rdi;
+    bool autoFormat = false;
+    bool blackSet = false;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t fourcc = 0;
+    RawFrameDesc desc;
+    bool sonyGain = true;
+    double gainConst = 512.0;
+    bool ae = true;
+    bool awb = true;
+    float gamma = 2.2f;
+};
+
+struct Stream {
+    Entry entry;
+    RawFrameDesc desc;
+    uint32_t outW = 0;
+    uint32_t outH = 0;
+    SoftIsp isp;
+    SoftAuto3A auto3a;
+    int subdevFd = -1;
+    uint32_t frames = 0;
+    struct v4l2_queryctrl expCtrl = {};
+    struct v4l2_queryctrl gainCtrl = {};
+};
+
+inline std::mutex &Lock()
+{
+    static std::mutex lock;
+    return lock;
+}
+
+inline std::map<int, std::unique_ptr<Stream>> &Streams()
+{
+    static std::map<int, std::unique_ptr<Stream>> streams;
+    return streams;
+}
+
+inline std::string FourccName(uint32_t f)
+{
+    char s[5] = {static_cast<char>(f & 0xFF), static_cast<char>((f >> 8) & 0xFF),
+        static_cast<char>((f >> 16) & 0xFF), static_cast<char>((f >> 24) & 0xFF), '\0'};
+    return std::string(s);
+}
+
+inline std::string ReadLine(const std::string &path)
+{
+    char buf[128] = {0};
+    FILE *f = fopen(path.c_str(), "r");
+    if (f == nullptr) {
+        return "";
+    }
+    if (fgets(buf, sizeof(buf), f) == nullptr) {
+        buf[0] = '\0';
+    }
+    fclose(f);
+    std::string s(buf);
+    while (!s.empty() && (s.back() == '\n' || s.back() == '\r' || s.back() == ' ')) {
+        s.pop_back();
+    }
+    return s;
+}
+
+inline bool ParseFormat(const std::string &name, Entry &e)
+{
+    struct Fmt {
+        const char *name;
+        uint32_t fourcc;
+        BayerOrder order;
+        RawPacking packing;
+        uint32_t white;
+    };
+    static const Fmt FORMATS[] = {
+        {"SRGGB10P", V4L2_PIX_FMT_SRGGB10P, BayerOrder::RGGB, RawPacking::RAW10_CSI2P, 1023},
+        {"SGRBG10P", V4L2_PIX_FMT_SGRBG10P, BayerOrder::GRBG, RawPacking::RAW10_CSI2P, 1023},
+        {"SGBRG10P", V4L2_PIX_FMT_SGBRG10P, BayerOrder::GBRG, RawPacking::RAW10_CSI2P, 1023},
+        {"SBGGR10P", V4L2_PIX_FMT_SBGGR10P, BayerOrder::BGGR, RawPacking::RAW10_CSI2P, 1023},
+        {"SRGGB10", V4L2_PIX_FMT_SRGGB10, BayerOrder::RGGB, RawPacking::RAW10_LE16, 1023},
+        {"SGRBG10", V4L2_PIX_FMT_SGRBG10, BayerOrder::GRBG, RawPacking::RAW10_LE16, 1023},
+        {"SGBRG10", V4L2_PIX_FMT_SGBRG10, BayerOrder::GBRG, RawPacking::RAW10_LE16, 1023},
+        {"SBGGR10", V4L2_PIX_FMT_SBGGR10, BayerOrder::BGGR, RawPacking::RAW10_LE16, 1023},
+        {"SRGGB12P", V4L2_PIX_FMT_SRGGB12P, BayerOrder::RGGB, RawPacking::RAW12_CSI2P, 4095},
+        {"SGRBG12P", V4L2_PIX_FMT_SGRBG12P, BayerOrder::GRBG, RawPacking::RAW12_CSI2P, 4095},
+        {"SGBRG12P", V4L2_PIX_FMT_SGBRG12P, BayerOrder::GBRG, RawPacking::RAW12_CSI2P, 4095},
+        {"SBGGR12P", V4L2_PIX_FMT_SBGGR12P, BayerOrder::BGGR, RawPacking::RAW12_CSI2P, 4095},
+        {"SRGGB12", V4L2_PIX_FMT_SRGGB12, BayerOrder::RGGB, RawPacking::RAW12_LE16, 4095},
+        {"SGRBG12", V4L2_PIX_FMT_SGRBG12, BayerOrder::GRBG, RawPacking::RAW12_LE16, 4095},
+        {"SGBRG12", V4L2_PIX_FMT_SGBRG12, BayerOrder::GBRG, RawPacking::RAW12_LE16, 4095},
+        {"SBGGR12", V4L2_PIX_FMT_SBGGR12, BayerOrder::BGGR, RawPacking::RAW12_LE16, 4095},
+        {"SRGGB8", V4L2_PIX_FMT_SRGGB8, BayerOrder::RGGB, RawPacking::RAW8, 255},
+        {"SGRBG8", V4L2_PIX_FMT_SGRBG8, BayerOrder::GRBG, RawPacking::RAW8, 255},
+        {"SGBRG8", V4L2_PIX_FMT_SGBRG8, BayerOrder::GBRG, RawPacking::RAW8, 255},
+        {"SBGGR8", V4L2_PIX_FMT_SBGGR8, BayerOrder::BGGR, RawPacking::RAW8, 255},
+    };
+    for (const auto &f : FORMATS) {
+        if (name == f.name) {
+            e.fourcc = f.fourcc;
+            e.desc.order = f.order;
+            e.desc.packing = f.packing;
+            e.desc.whiteLevel = f.white;
+            e.desc.blackLevel = (f.white + 1) / 16; // 64 for 10 bit, 256 for 12, 16 for 8
+            return true;
+        }
+    }
+    return false;
+}
+
+inline void ParseLine(const std::string &line, std::vector<Entry> &entries)
+{
+    Entry e;
+    bool blackSet = false;
+    uint32_t black = 0;
+    size_t pos = 0;
+    while (pos < line.size()) {
+        size_t end = line.find_first_of(" \t", pos);
+        std::string tok = line.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+        pos = (end == std::string::npos) ? line.size() : end + 1;
+        size_t eq = tok.find('=');
+        if (eq == std::string::npos) {
+            continue;
+        }
+        std::string key = tok.substr(0, eq);
+        std::string val = tok.substr(eq + 1);
+        if (key == "hw") {
+            e.hw = val;
+        } else if (key == "video") {
+            e.video = val;
+        } else if (key == "sensor") {
+            e.sensor = val;
+        } else if (key == "width") {
+            e.width = static_cast<uint32_t>(strtoul(val.c_str(), nullptr, 0));
+        } else if (key == "height") {
+            e.height = static_cast<uint32_t>(strtoul(val.c_str(), nullptr, 0));
+        } else if (key == "rdi") {
+            e.rdi = val;
+        } else if (key == "format" && val == "auto") {
+            e.autoFormat = true;
+        } else if (key == "format") {
+            if (!ParseFormat(val, e)) {
+                CAMERA_LOGE("camss_raw: unknown format %{public}s", val.c_str());
+                return;
+            }
+        } else if (key == "black") {
+            black = static_cast<uint32_t>(strtoul(val.c_str(), nullptr, 0));
+            blackSet = true;
+        } else if (key == "gain") {
+            e.sonyGain = val.compare(0, 5, "sony:") == 0;
+            size_t colon = val.find(':');
+            if (colon != std::string::npos) {
+                e.gainConst = strtod(val.c_str() + colon + 1, nullptr);
+            }
+        } else if (key == "ae") {
+            e.ae = val != "off";
+        } else if (key == "awb") {
+            e.awb = val != "off";
+        } else if (key == "gamma") {
+            e.gamma = strtof(val.c_str(), nullptr);
+        }
+    }
+    bool explicitFormat = e.fourcc != 0 && e.width >= 2 && e.height >= 2;
+    bool fromRdi = !e.rdi.empty() && (e.autoFormat || !explicitFormat);
+    if (e.hw.empty() || e.video.empty() || (!explicitFormat && !fromRdi)) {
+        CAMERA_LOGE("camss_raw: ignoring incomplete line: %{public}s", line.c_str());
+        return;
+    }
+    e.autoFormat = fromRdi;
+    e.blackSet = blackSet;
+    if (blackSet) {
+        e.desc.blackLevel = black;
+    }
+    if (e.gainConst <= 1.0 || e.gamma < 1.0f) {
+        e.gainConst = 512.0;
+        e.gamma = 2.2f;
+    }
+    e.desc.width = e.width;
+    e.desc.height = e.height;
+    entries.push_back(e);
+}
+
+inline const std::vector<Entry> &Entries()
+{
+    static std::vector<Entry> entries;
+    static std::once_flag once;
+    std::call_once(once, [] {
+        FILE *f = fopen(CONFIG_PATH, "r");
+        if (f == nullptr) {
+            return;
+        }
+        char buf[512];
+        while (fgets(buf, sizeof(buf), f) != nullptr) {
+            std::string line(buf);
+            size_t hash = line.find('#');
+            if (hash != std::string::npos) {
+                line.resize(hash);
+            }
+            while (!line.empty() && (line.back() == '\n' || line.back() == '\r')) {
+                line.pop_back();
+            }
+            if (line.find('=') != std::string::npos) {
+                ParseLine(line, entries);
+            }
+        }
+        fclose(f);
+        CAMERA_LOGI("camss_raw: %{public}u raw camera(s) in %{public}s", static_cast<unsigned>(entries.size()),
+            CONFIG_PATH);
+    });
+    return entries;
+}
+
+// sysfs name of a char device node, e.g. /dev/video3 -> "msm_vfe0_video0"
+inline std::string NodeNameOfRdev(dev_t rdev)
+{
+    char path[64];
+    (void)snprintf(path, sizeof(path), "/sys/dev/char/%u:%u/name", major(rdev), minor(rdev));
+    return ReadLine(path);
+}
+
+inline bool EntryMatchesNode(const Entry &e, const std::string &devPath, dev_t rdev)
+{
+    if (e.video.compare(0, 5, "/dev/") == 0) {
+        struct stat st = {};
+        return stat(e.video.c_str(), &st) == 0 && st.st_rdev == rdev;
+    }
+    return NodeNameOfRdev(rdev) == e.video;
+}
+
+// V4L2MatchDevice: does /dev/videoN belong to the raw camera named hwName?
+inline bool MatchNode(const std::string &devPath, const std::string &hwName)
+{
+    struct stat st = {};
+    if (stat(devPath.c_str(), &st) != 0) {
+        return false;
+    }
+    for (const auto &e : Entries()) {
+        if (e.hw == hwName && EntryMatchesNode(e, devPath, st.st_rdev)) {
+            CAMERA_LOGI("camss_raw: %{public}s is %{public}s", devPath.c_str(), hwName.c_str());
+            return true;
+        }
+    }
+    return false;
+}
+
+inline const Entry *EntryOfFd(int fd)
+{
+    struct stat st = {};
+    if (Entries().empty() || fstat(fd, &st) != 0 || !S_ISCHR(st.st_mode)) {
+        return nullptr;
+    }
+    for (const auto &e : Entries()) {
+        if (EntryMatchesNode(e, "", st.st_rdev)) {
+            return &e;
+        }
+    }
+    return nullptr;
+}
+
+// media bus code of a CAMSS RDI pad -> the capture node's pixel format (CAMSS RDI writes 10/12-bit
+// Bayer MIPI-packed), Bayer order, packing and white level
+inline bool ApplyMbusCode(uint32_t code, Entry &e)
+{
+    struct Map {
+        uint32_t code;
+        const char *name;
+    };
+    static const Map MAPS[] = {
+        {MEDIA_BUS_FMT_SRGGB10_1X10, "SRGGB10P"}, {MEDIA_BUS_FMT_SGRBG10_1X10, "SGRBG10P"},
+        {MEDIA_BUS_FMT_SGBRG10_1X10, "SGBRG10P"}, {MEDIA_BUS_FMT_SBGGR10_1X10, "SBGGR10P"},
+        {MEDIA_BUS_FMT_SRGGB12_1X12, "SRGGB12P"}, {MEDIA_BUS_FMT_SGRBG12_1X12, "SGRBG12P"},
+        {MEDIA_BUS_FMT_SGBRG12_1X12, "SGBRG12P"}, {MEDIA_BUS_FMT_SBGGR12_1X12, "SBGGR12P"},
+        {MEDIA_BUS_FMT_SRGGB8_1X8, "SRGGB8"}, {MEDIA_BUS_FMT_SGRBG8_1X8, "SGRBG8"},
+        {MEDIA_BUS_FMT_SGBRG8_1X8, "SGBRG8"}, {MEDIA_BUS_FMT_SBGGR8_1X8, "SBGGR8"},
+    };
+    for (const auto &m : MAPS) {
+        if (m.code == code) {
+            uint32_t black = e.desc.blackLevel;
+            bool ok = ParseFormat(m.name, e);
+            if (ok && e.blackSet) {
+                e.desc.blackLevel = black;
+            }
+            return ok;
+        }
+    }
+    return false;
+}
+
+// /dev/v4l-subdevN whose sysfs name equals name (exact) or starts with it (prefix)
+inline int OpenSubdev(const std::string &name, bool prefix)
+{
+    if (name.empty()) {
+        return -1;
+    }
+    DIR *dir = opendir("/sys/class/video4linux");
+    if (dir == nullptr) {
+        return -1;
+    }
+    int fd = -1;
+    struct dirent *ent = nullptr;
+    while ((ent = readdir(dir)) != nullptr) {
+        std::string node(ent->d_name);
+        if (node.compare(0, 10, "v4l-subdev") != 0) {
+            continue;
+        }
+        std::string n = ReadLine("/sys/class/video4linux/" + node + "/name");
+        if (prefix ? n.compare(0, name.size(), name) == 0 : n == name) {
+            fd = open(("/dev/" + node).c_str(), O_RDWR | O_CLOEXEC);
+            CAMERA_LOGI("camss_raw: subdev /dev/%{public}s (%{public}s) fd %{public}d errno %{public}d",
+                node.c_str(), n.c_str(), fd, fd < 0 ? errno : 0);
+            break;
+        }
+    }
+    closedir(dir);
+    return fd;
+}
+
+// format=auto: the active format on the RDI subdev's sink pad, as set at boot (camss_setup / media-ctl)
+inline bool ResolveFromRdi(Entry &e)
+{
+    int fd = OpenSubdev(e.rdi, false);
+    if (fd < 0) {
+        return false;
+    }
+    struct v4l2_subdev_format f = {};
+    f.which = V4L2_SUBDEV_FORMAT_ACTIVE;
+    f.pad = 0;
+    int ret = ioctl(fd, VIDIOC_SUBDEV_G_FMT, &f);
+    close(fd);
+    if (ret < 0 || f.format.width < 2 || f.format.height < 2 || !ApplyMbusCode(f.format.code, e)) {
+        CAMERA_LOGE("camss_raw: %{public}s pad 0: ret %{public}d code 0x%{public}x %{public}ux%{public}u not usable",
+            e.rdi.c_str(), ret, f.format.code, f.format.width, f.format.height);
+        return false;
+    }
+    e.width = f.format.width;
+    e.height = f.format.height;
+    e.desc.width = e.width;
+    e.desc.height = e.height;
+    return true;
+}
+
+inline int OpenSensorSubdev(const std::string &prefix)
+{
+    return OpenSubdev(prefix, true);
+}
+
+inline double GainOfCode(const Entry &e, int32_t code)
+{
+    if (e.sonyGain) {
+        double den = e.gainConst - code;
+        return den > 0 ? e.gainConst / den : 1.0;
+    }
+    return code / e.gainConst;
+}
+
+inline int32_t CodeOfGain(const Entry &e, double gain)
+{
+    if (e.sonyGain) {
+        return static_cast<int32_t>(e.gainConst - e.gainConst / gain + 0.5);
+    }
+    return static_cast<int32_t>(gain * e.gainConst + 0.5);
+}
+
+inline void InitSensorControl(Stream &s)
+{
+    s.auto3a.limits.sensorControl = false;
+    s.auto3a.limits.minDgain = 0.25;
+    s.auto3a.limits.maxDgain = 16.0;
+    if (!s.entry.ae || s.subdevFd < 0) {
+        return;
+    }
+    s.expCtrl.id = V4L2_CID_EXPOSURE;
+    s.gainCtrl.id = V4L2_CID_ANALOGUE_GAIN;
+    struct v4l2_control exp = {V4L2_CID_EXPOSURE, 0};
+    struct v4l2_control gain = {V4L2_CID_ANALOGUE_GAIN, 0};
+    if (ioctl(s.subdevFd, VIDIOC_QUERYCTRL, &s.expCtrl) < 0 || ioctl(s.subdevFd, VIDIOC_QUERYCTRL, &s.gainCtrl) < 0 ||
+        ioctl(s.subdevFd, VIDIOC_G_CTRL, &exp) < 0 || ioctl(s.subdevFd, VIDIOC_G_CTRL, &gain) < 0) {
+        CAMERA_LOGE("camss_raw: sensor exposure/gain controls not usable, errno %{public}d", errno);
+        return;
+    }
+    s.auto3a.limits.sensorControl = true;
+    s.auto3a.limits.minLines = std::max(1, s.expCtrl.minimum);
+    s.auto3a.limits.maxLines = std::max(s.expCtrl.minimum, s.expCtrl.maximum);
+    s.auto3a.limits.maxAgain = std::max(1.0, GainOfCode(s.entry, s.gainCtrl.maximum));
+    s.auto3a.limits.minDgain = 1.0;
+    s.auto3a.limits.maxDgain = 4.0;
+    s.auto3a.exposure.lines = std::max(1, exp.value);
+    s.auto3a.exposure.again = std::max(1.0, GainOfCode(s.entry, gain.value));
+    CAMERA_LOGI("camss_raw: exposure %{public}d [%{public}d..%{public}d] lines, gain code %{public}d max %{public}d",
+        exp.value, s.expCtrl.minimum, s.expCtrl.maximum, gain.value, s.gainCtrl.maximum);
+}
+
+inline void ApplySensorExposure(Stream &s)
+{
+    if (!s.auto3a.limits.sensorControl) {
+        return;
+    }
+    struct v4l2_control exp = {V4L2_CID_EXPOSURE, static_cast<int32_t>(s.auto3a.exposure.lines + 0.5)};
+    int32_t code = CodeOfGain(s.entry, s.auto3a.exposure.again);
+    code = std::min(std::max(code, s.gainCtrl.minimum), s.gainCtrl.maximum);
+    struct v4l2_control gain = {V4L2_CID_ANALOGUE_GAIN, code};
+    if (ioctl(s.subdevFd, VIDIOC_S_CTRL, &exp) < 0 || ioctl(s.subdevFd, VIDIOC_S_CTRL, &gain) < 0) {
+        CAMERA_LOGE("camss_raw: set exposure/gain failed, errno %{public}d", errno);
+    }
+}
+
+// V4L2SetFmt: for a raw node, set the configured raw format instead of the pipeline's YUV request
+// and remember the request (size) as the output of the software conversion. Returns false when fd
+// is not a raw node (caller continues as usual).
+inline bool SetFormat(int fd, uint32_t bufType, uint32_t reqWidth, uint32_t reqHeight, uint32_t reqFourcc, bool &ok)
+{
+    const Entry *configured = EntryOfFd(fd);
+    if (configured == nullptr) {
+        return false;
+    }
+    ok = false;
+    Entry resolved = *configured;
+    const Entry *e = &resolved;
+    if (resolved.autoFormat && !ResolveFromRdi(resolved)) {
+        resolved = *configured;
+        if (resolved.fourcc == 0 || resolved.width < 2 || resolved.height < 2) {
+            CAMERA_LOGE("camss_raw: %{public}s: no raw format (rdi %{public}s unreadable, no explicit format)",
+                resolved.hw.c_str(), resolved.rdi.c_str());
+            return true;
+        }
+        CAMERA_LOGE("camss_raw: %{public}s: rdi format unreadable, using the configured %{public}s %{public}ux%{public}u",
+            resolved.hw.c_str(), FourccName(resolved.fourcc).c_str(), resolved.width, resolved.height);
+    }
+    struct v4l2_format fmt = {};
+    fmt.type = bufType;
+    if (bufType == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
+        fmt.fmt.pix_mp.pixelformat = e->fourcc;
+        fmt.fmt.pix_mp.width = e->width;
+        fmt.fmt.pix_mp.height = e->height;
+        fmt.fmt.pix_mp.field = V4L2_FIELD_NONE;
+        fmt.fmt.pix_mp.num_planes = 1;
+    } else {
+        fmt.fmt.pix.pixelformat = e->fourcc;
+        fmt.fmt.pix.width = e->width;
+        fmt.fmt.pix.height = e->height;
+        fmt.fmt.pix.field = V4L2_FIELD_NONE;
+    }
+    if (ioctl(fd, VIDIOC_S_FMT, &fmt) < 0) {
+        CAMERA_LOGE("camss_raw: VIDIOC_S_FMT %{public}ux%{public}u failed: %{public}s", e->width, e->height,
+            strerror(errno));
+        return true;
+    }
+    bool mp = bufType == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    uint32_t pixfmt = mp ? fmt.fmt.pix_mp.pixelformat : fmt.fmt.pix.pixelformat;
+    uint32_t w = mp ? fmt.fmt.pix_mp.width : fmt.fmt.pix.width;
+    uint32_t h = mp ? fmt.fmt.pix_mp.height : fmt.fmt.pix.height;
+    uint32_t bpl = mp ? fmt.fmt.pix_mp.plane_fmt[0].bytesperline : fmt.fmt.pix.bytesperline;
+    if (pixfmt != e->fourcc || w != e->width || h != e->height) {
+        CAMERA_LOGE("camss_raw: driver set %{public}s %{public}ux%{public}u, wanted %{public}s %{public}ux%{public}u",
+            FourccName(pixfmt).c_str(), w, h, FourccName(e->fourcc).c_str(), e->width, e->height);
+        return true;
+    }
+    auto s = std::make_unique<Stream>();
+    s->entry = *e;
+    s->desc = e->desc;
+    s->desc.bytesPerLine = bpl;
+    s->outW = (reqWidth >= 2 ? reqWidth : e->width / 2) & ~1u;
+    s->outH = (reqHeight >= 2 ? reqHeight : e->height / 2) & ~1u;
+    s->isp.SetGamma(e->gamma);
+    s->subdevFd = e->ae ? OpenSensorSubdev(e->sensor) : -1;
+    InitSensorControl(*s);
+    CAMERA_LOGI("camss_raw: %{public}s raw %{public}ux%{public}u bpl %{public}u -> I420 %{public}ux%{public}u "
+        "(pipeline asked %{public}s)", e->hw.c_str(), w, h, bpl, s->outW, s->outH, FourccName(reqFourcc).c_str());
+    std::lock_guard<std::mutex> l(Lock());
+    auto it = Streams().find(fd);
+    if (it != Streams().end() && it->second->subdevFd >= 0) {
+        close(it->second->subdevFd);
+    }
+    Streams()[fd] = std::move(s);
+    ok = true;
+    return true;
+}
+
+inline bool IsRaw(int fd)
+{
+    std::lock_guard<std::mutex> l(Lock());
+    return Streams().count(fd) != 0;
+}
+
+// V4L2DequeueBuffer: raw frame (mmap'ed V4L2 buffer) -> I420 in the pipeline's buffer.
+inline bool Convert(int fd, const void *raw, uint32_t bytesUsed, void *out, uint32_t outSize)
+{
+    std::lock_guard<std::mutex> l(Lock());
+    auto it = Streams().find(fd);
+    if (it == Streams().end()) {
+        return false;
+    }
+    Stream &s = *it->second;
+    s.isp.SetGains(s.entry.awb ? s.auto3a.gainR : 1.0, s.entry.awb ? s.auto3a.gainB : 1.0, s.auto3a.exposure.dgain);
+    SoftIspStats stats;
+    if (!s.isp.ToI420(static_cast<const uint8_t *>(raw), bytesUsed, s.desc, static_cast<uint8_t *>(out), outSize,
+        s.outW, s.outH, &stats)) {
+        CAMERA_LOGE("camss_raw: conversion failed (raw %{public}u bytes, out %{public}u bytes for %{public}ux"
+            "%{public}u)", bytesUsed, outSize, s.outW, s.outH);
+        return false;
+    }
+    if (s.entry.awb) {
+        s.auto3a.UpdateAwb(stats);
+    }
+    if (s.entry.ae && (++s.frames % AE_PERIOD) == 0 && s.auto3a.UpdateAe(stats)) {
+        ApplySensorExposure(s);
+    }
+    return true;
+}
+
+inline void Release(int fd)
+{
+    std::lock_guard<std::mutex> l(Lock());
+    auto it = Streams().find(fd);
+    if (it != Streams().end()) {
+        if (it->second->subdevFd >= 0) {
+            close(it->second->subdevFd);
+        }
+        Streams().erase(it);
+    }
+}
+} // namespace CamssRaw
+} // namespace OHOS::Camera
+#endif // HOS_CAMERA_CAMSS_RAW_H
