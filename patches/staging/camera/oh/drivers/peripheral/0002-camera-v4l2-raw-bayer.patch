+/*
+ * Minimal software ISP for sensors behind an ISP-less capture path (Qualcomm CAMSS RDI):
+ * raw Bayer -> I420 (YUV 4:2:0 planar, BT.601 limited range), the layout the V4L2 source node
+ * hands on as CAMERA_FORMAT_YCRCB_420_P (same as rk3568's rkisp YUV420 output).
+ *
+ * Per output pixel one 2x2 Bayer quad is sampled (nearest quad, i.e. 2x2 binning plus a
+ * nearest-neighbour scale), black level removed, white-balance + digital gain applied and a
+ * gamma LUT used. Chroma is the mean of the 2x2 output block. Statistics for AE/AWB are taken
+ * on every 4th output pixel in both directions. Header only, no OpenHarmony dependencies.
+ */
+#ifndef HOS_CAMERA_CAMSS_SOFT_ISP_H
+#define HOS_CAMERA_CAMSS_SOFT_ISP_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace OHOS::Camera {
+enum class BayerOrder : uint8_t { RGGB = 0, GRBG = 1, GBRG = 2, BGGR = 3 };
+enum class RawPacking : uint8_t { RAW8 = 0, RAW10_CSI2P, RAW10_LE16, RAW12_CSI2P, RAW12_LE16 };
+
+struct RawFrameDesc {
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t bytesPerLine = 0;
+    BayerOrder order = BayerOrder::RGGB;
+    RawPacking packing = RawPacking::RAW10_CSI2P;
+    uint32_t blackLevel = 64;   // in the packing's native code units
+    uint32_t whiteLevel = 1023; // idem
+};
+
+struct SoftIspStats {
+    uint64_t sumR = 0; // near-neutral samples only (AWB): linear, black removed, 12-bit, before gains
+    uint64_t sumG = 0;
+    uint64_t sumB = 0;
+    uint32_t count = 0;
+    uint64_t sumY = 0; // all unclipped samples (AE): luma after white balance, before digital gain
+    uint32_t countY = 0;
+    uint32_t saturated = 0;
+};
+
+class SoftIsp {
+public:
+    static constexpr uint32_t LIN_MAX = 4095;
+
+    SoftIsp()
+    {
+        SetGamma(2.2f);
+        SetGains(1.0f, 1.0f, 1.0f);
+    }
+
+    void SetGamma(float gamma)
+    {
+        for (uint32_t i = 0; i <= LIN_MAX; i++) {
+            float v = std::pow(static_cast<float>(i) / LIN_MAX, 1.0f / gamma);
+            lut_[i] = static_cast<uint8_t>(std::min(255.0f, v * 255.0f + 0.5f));
+        }
+    }
+
+    // wbR/wbB: white-balance gains relative to green; digital: gain applied to all channels.
+    void SetGains(float wbR, float wbB, float digital)
+    {
+        wbR_ = std::max(1u, Q8(wbR));
+        wbB_ = std::max(1u, Q8(wbB));
+        gainR_ = std::max(1u, Q8(wbR * digital));
+        gainG_ = std::max(1u, Q8(digital));
+        gainB_ = std::max(1u, Q8(wbB * digital));
+    }
+
+    // raw: bytesUsed bytes laid out as d; out: I420 of outW x outH (both even).
+    bool ToI420(const uint8_t *raw, size_t bytesUsed, const RawFrameDesc &d,
+        uint8_t *out, size_t outSize, uint32_t outW, uint32_t outH, SoftIspStats *stats)
+    {
+        outW &= ~1u;
+        outH &= ~1u;
+        if (raw == nullptr || out == nullptr || d.width < 2 || d.height < 2 || outW == 0 || outH == 0) {
+            return false;
+        }
+        if (static_cast<size_t>(outW) * outH * 3 / 2 > outSize) {
+            return false;
+        }
+        if (static_cast<size_t>(d.bytesPerLine) * d.height > bytesUsed || d.bytesPerLine < MinLineBytes(d)) {
+            return false;
+        }
+        switch (d.packing) {
+            case RawPacking::RAW8:
+                Convert<RawPacking::RAW8>(raw, d, out, outW, outH, stats);
+                break;
+            case RawPacking::RAW10_CSI2P:
+                Convert<RawPacking::RAW10_CSI2P>(raw, d, out, outW, outH, stats);
+                break;
+            case RawPacking::RAW10_LE16:
+                Convert<RawPacking::RAW10_LE16>(raw, d, out, outW, outH, stats);
+                break;
+            case RawPacking::RAW12_CSI2P:
+                Convert<RawPacking::RAW12_CSI2P>(raw, d, out, outW, outH, stats);
+                break;
+            case RawPacking::RAW12_LE16:
+                Convert<RawPacking::RAW12_LE16>(raw, d, out, outW, outH, stats);
+                break;
+            default:
+                return false;
+        }
+        return true;
+    }
+
+    static uint32_t MinLineBytes(const RawFrameDesc &d)
+    {
+        switch (d.packing) {
+            case RawPacking::RAW8:
+                return d.width;
+            case RawPacking::RAW10_CSI2P:
+                return (d.width + 3) / 4 * 5;
+            case RawPacking::RAW12_CSI2P:
+                return (d.width + 1) / 2 * 3;
+            default:
+                return d.width * 2;
+        }
+    }
+
+private:
+    static uint32_t Q8(float v)
+    {
+        return static_cast<uint32_t>(std::max(0.0f, v) * 256.0f + 0.5f);
+    }
+
+    template <RawPacking P>
+    static inline uint32_t Sample(const uint8_t *row, uint32_t x)
+    {
+        if constexpr (P == RawPacking::RAW8) {
+            return row[x];
+        } else if constexpr (P == RawPacking::RAW10_CSI2P) {
+            const uint8_t *g = row + (x >> 2) * 5;
+            uint32_t i = x & 3;
+            return (static_cast<uint32_t>(g[i]) << 2) | ((g[4] >> (i * 2)) & 0x3);
+        } else if constexpr (P == RawPacking::RAW12_CSI2P) {
+            const uint8_t *g = row + (x >> 1) * 3;
+            uint32_t i = x & 1;
+            return (static_cast<uint32_t>(g[i]) << 4) | ((g[2] >> (i * 4)) & 0xF);
+        } else if constexpr (P == RawPacking::RAW10_LE16) {
+            return (row[x * 2] | (static_cast<uint32_t>(row[x * 2 + 1]) << 8)) & 0x3FF;
+        } else {
+            return (row[x * 2] | (static_cast<uint32_t>(row[x * 2 + 1]) << 8)) & 0xFFF;
+        }
+    }
+
+    // AE uses every unclipped sample; grey-world AWB only those that are near neutral under the
+    // current white balance (r/g and b/g within 1/2..2), so large coloured areas do not tint the result.
+    inline void Accumulate(SoftIspStats &st, uint32_t r, uint32_t g, uint32_t b, bool clipped) const
+    {
+        if (clipped) {
+            st.saturated++;
+            return;
+        }
+        uint32_t rw = r * wbR_ / 256;
+        uint32_t bw = b * wbB_ / 256;
+        st.sumY += (rw * 77 + g * 150 + bw * 29) / 256;
+        st.countY++;
+        if (g > 16 && rw * 2 >= g && rw <= g * 2 && bw * 2 >= g && bw <= g * 2) {
+            st.sumR += r;
+            st.sumG += g;
+            st.sumB += b;
+            st.count++;
+        }
+    }
+
+    static inline uint8_t Clip8(int v)
+    {
+        return static_cast<uint8_t>(v < 0 ? 0 : (v > 255 ? 255 : v));
+    }
+
+    template <RawPacking P>
+    void Convert(const uint8_t *raw, const RawFrameDesc &d, uint8_t *out, uint32_t outW, uint32_t outH,
+        SoftIspStats *stats)
+    {
+        // index (0..3 = (0,0) (0,1) (1,0) (1,1)) of R and B in a quad, per Bayer order
+        static const uint8_t R_INDEX[4] = {0, 1, 2, 3};
+        static const uint8_t B_INDEX[4] = {3, 2, 1, 0};
+        const uint32_t ri = R_INDEX[static_cast<uint32_t>(d.order) & 3];
+        const uint32_t bi = B_INDEX[static_cast<uint32_t>(d.order) & 3];
+        uint32_t gi[2];
+        for (uint32_t i = 0, n = 0; i < 4; i++) {
+            if (i != ri && i != bi) {
+                gi[n++] = i;
+            }
+        }
+        const uint32_t black = d.blackLevel;
+        const uint32_t range = d.whiteLevel > black ? d.whiteLevel - black : 1;
+        const uint32_t norm = (LIN_MAX << 16) / range; // Q16, native code -> 12-bit linear
+        const uint32_t satLevel = d.whiteLevel - d.whiteLevel / 32;
+        const uint32_t quadW = d.width / 2;
+        const uint32_t quadH = d.height / 2;
+
+        colX_.resize(outW);
+        for (uint32_t ox = 0; ox < outW; ox++) {
+            colX_[ox] = static_cast<uint32_t>(static_cast<uint64_t>(ox) * quadW / outW) * 2;
+        }
+        uint8_t *yPlane = out;
+        uint8_t *uPlane = out + static_cast<size_t>(outW) * outH;
+        uint8_t *vPlane = uPlane + static_cast<size_t>(outW / 2) * (outH / 2);
+        SoftIspStats st;
+
+        for (uint32_t oy = 0; oy < outH; oy += 2) {
+            const uint8_t *rows[2][2];
+            for (uint32_t dy = 0; dy < 2; dy++) {
+                uint32_t sy = static_cast<uint32_t>(static_cast<uint64_t>(oy + dy) * quadH / outH) * 2;
+                rows[dy][0] = raw + static_cast<size_t>(sy) * d.bytesPerLine;
+                rows[dy][1] = rows[dy][0] + d.bytesPerLine;
+            }
+            uint8_t *y0 = yPlane + static_cast<size_t>(oy) * outW;
+            uint8_t *y1 = y0 + outW;
+            uint8_t *u = uPlane + static_cast<size_t>(oy / 2) * (outW / 2);
+            uint8_t *v = vPlane + static_cast<size_t>(oy / 2) * (outW / 2);
+            for (uint32_t ox = 0; ox < outW; ox += 2) {
+                int sumR = 0;
+                int sumG = 0;
+                int sumB = 0;
+                for (uint32_t dy = 0; dy < 2; dy++) {
+                    uint8_t *yRow = dy == 0 ? y0 : y1;
+                    for (uint32_t dx = 0; dx < 2; dx++) {
+                        uint32_t x = colX_[ox + dx];
+                        uint32_t q[4] = {
+                            Sample<P>(rows[dy][0], x), Sample<P>(rows[dy][0], x + 1),
+                            Sample<P>(rows[dy][1], x), Sample<P>(rows[dy][1], x + 1),
+                        };
+                        uint32_t r = q[ri] > black ? q[ri] - black : 0;
+                        uint32_t g = ((q[gi[0]] > black ? q[gi[0]] - black : 0) +
+                                      (q[gi[1]] > black ? q[gi[1]] - black : 0)) >> 1;
+                        uint32_t b = q[bi] > black ? q[bi] - black : 0;
+                        r = std::min(LIN_MAX, (r * norm) >> 16);
+                        g = std::min(LIN_MAX, (g * norm) >> 16);
+                        b = std::min(LIN_MAX, (b * norm) >> 16);
+                        bool clipped = q[0] >= satLevel || q[1] >= satLevel || q[2] >= satLevel || q[3] >= satLevel;
+                        if (((ox + dx) & 3) == 0 && ((oy + dy) & 3) == 0) {
+                            Accumulate(st, r, g, b, clipped);
+                        }
+                        int r8 = 255;
+                        int g8 = 255;
+                        int b8 = 255;
+                        if (!clipped) { // clipped highlights stay white instead of turning magenta/blue
+                            r8 = lut_[std::min(LIN_MAX, (r * gainR_) >> 8)];
+                            g8 = lut_[std::min(LIN_MAX, (g * gainG_) >> 8)];
+                            b8 = lut_[std::min(LIN_MAX, (b * gainB_) >> 8)];
+                        }
+                        yRow[ox + dx] = Clip8(((66 * r8 + 129 * g8 + 25 * b8 + 128) >> 8) + 16);
+                        sumR += r8;
+                        sumG += g8;
+                        sumB += b8;
+                    }
+                }
+                sumR >>= 2;
+                sumG >>= 2;
+                sumB >>= 2;
+                u[ox / 2] = Clip8(((-38 * sumR - 74 * sumG + 112 * sumB + 128) >> 8) + 128);
+                v[ox / 2] = Clip8(((112 * sumR - 94 * sumG - 18 * sumB + 128) >> 8) + 128);
+            }
+        }
+        if (stats != nullptr) {
+            *stats = st;
+        }
+    }
+
+    uint8_t lut_[LIN_MAX + 1] = {};
+    uint32_t gainR_ = 256; // Q8, white balance x digital gain
+    uint32_t gainG_ = 256;
+    uint32_t gainB_ = 256;
+    uint32_t wbR_ = 256; // Q8, white balance only (statistics)
+    uint32_t wbB_ = 256;
+    std::vector<uint32_t> colX_;
+};
+
+/*
+ * Grey-world AWB and a mean-luminance AE that splits the wanted exposure into sensor
+ * exposure lines, sensor analogue gain and the software digital gain. Pure arithmetic;
+ * the caller reads/writes the sensor controls.
+ */
+class SoftAuto3A {
+public:
+    struct Limits {
+        double minLines = 1;
+        double maxLines = 1;
+        double maxAgain = 1;
+        double minDgain = 1.0;
+        double maxDgain = 8.0;
+        bool sensorControl = false;
+    };
+    struct Exposure {
+        double lines = 1;
+        double again = 1;
+        double dgain = 1;
+    };
+
+    double gainR = 1.8; // a daylight-ish start for Sony RGB sensors
+    double gainB = 1.6;
+    Exposure exposure;
+    Limits limits;
+    double target = 0.18; // linear mid grey
+
+    void UpdateAwb(const SoftIspStats &s)
+    {
+        if (s.count < MIN_SAMPLES || s.sumR == 0 || s.sumB == 0 || s.sumG == 0) {
+            return;
+        }
+        double r = static_cast<double>(s.sumG) / s.sumR;
+        double b = static_cast<double>(s.sumG) / s.sumB;
+        r = std::clamp(r, 0.5, 4.0);
+        b = std::clamp(b, 0.5, 4.0);
+        gainR = gainR * (1 - AWB_SPEED) + r * AWB_SPEED;
+        gainB = gainB * (1 - AWB_SPEED) + b * AWB_SPEED;
+    }
+
+    // Returns true when exposure changed. The mean is taken after white balance, before the
+    // digital gain; clipped samples count as white.
+    bool UpdateAe(const SoftIspStats &s)
+    {
+        double total = static_cast<double>(s.countY) + s.saturated;
+        if (total < MIN_SAMPLES) {
+            return false;
+        }
+        double luma = (static_cast<double>(s.sumY) / SoftIsp::LIN_MAX + s.saturated) / total;
+        double measured = std::max(luma * exposure.dgain, 1e-4);
+        double ratio = std::clamp(target / measured, 0.25, 4.0);
+        if (std::fabs(std::log(ratio)) < std::log(DEAD_BAND)) {
+            return false;
+        }
+        ratio = std::pow(ratio, DAMPING);
+        double want = exposure.lines * exposure.again * exposure.dgain * ratio;
+        Exposure e;
+        if (limits.sensorControl) {
+            e.lines = std::clamp(want, limits.minLines, limits.maxLines);
+            e.again = std::clamp(want / e.lines, 1.0, limits.maxAgain);
+            e.dgain = std::clamp(want / (e.lines * e.again), limits.minDgain, limits.maxDgain);
+        } else {
+            e.lines = exposure.lines;
+            e.again = exposure.again;
+            e.dgain = std::clamp(want / (e.lines * e.again), limits.minDgain, limits.maxDgain);
+        }
+        exposure = e;
+        return true;
+    }
+
+private:
+    static constexpr uint32_t MIN_SAMPLES = 64;
+    static constexpr double AWB_SPEED = 0.2;
+    static constexpr double DEAD_BAND = 1.08;
+    static constexpr double DAMPING = 0.6;
+};
