diff --git a/fajita/hdf_config/uhdf/camera/camss_raw.cfg b/fajita/hdf_config/uhdf/camera/camss_raw.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..dfd4c782fe37179ff45963b0c40930e1fb4873dd
--- /dev/null
+++ b/fajita/hdf_config/uhdf/camera/camss_raw.cfg
@@ -0,0 +1,22 @@
+# Raw Bayer cameras behind Qualcomm CAMSS (no ISP), read by the V4L2 adapter of camera_host
+# (drivers/peripheral/camera .../driver_adapter/include/camss_raw.h). Installed as
+# /vendor/etc/camera/camss_raw.cfg. One line per camera; see camss_raw.h for all keys.
+#
+# hw     = DM_C_SENSOR name in device/board/oneplus/fajita/camera/vdi_impl/v4l2/device_manager/include/project_hardware.h
+# video  = name of the CAMSS capture node (cat /sys/class/video4linux/video*/name): msm_vfeN_videoM is
+#          the node of subdev msm_vfeN_rdiM (M = 0..2, 3 = pix)
+# rdi    = the VFE line subdev feeding that node; with format=auto its pad-0 format (set by
+#          /vendor/bin/camss_setup at boot from the sensor's current code) gives the raw format and size,
+#          so the Bayer order follows the sensor's flip controls (IMX376 default: SBGGR10_1X10)
+# sensor = prefix of the sensor subdev name ("imx376 <bus>-0010"); camera_host sets
+#          V4L2_CID_EXPOSURE / V4L2_CID_ANALOGUE_GAIN on it for auto exposure
+# Without access to the rdi subdev, give the format explicitly instead of format=auto, e.g.
+#          width=2592 height=1940 format=SBGGR10P
+#
+# Rear Sony IMX376K: CSIPHY1 -> CSID0 (source pad 1) -> VFE0 RDI0 -> msm_vfe0_video0, 2592x1940 RAW10.
+hw=imx376 video=msm_vfe0_video0 rdi=msm_vfe0_rdi0 sensor=imx376 format=auto black=64 gain=sony:512
+# Later, once routed by a camss_setup service in init.fajita.cfg and added to project_hardware.h +
+# camera_host_config.hcs:
+# front IMX371 (CSIPHY2, 4656x3496, defaults SBGGR10), rear IMX519 (CSIPHY0, C-PHY, flips 0)
+#hw=imx371 video=msm_vfe1_video0 rdi=msm_vfe1_rdi0 sensor=imx371 format=auto black=64 gain=sony:512
+#hw=imx519 video=msm_vfe2_video0 rdi=msm_vfe2_rdi0 sensor=imx519 format=auto black=64 gain=sony:1024
