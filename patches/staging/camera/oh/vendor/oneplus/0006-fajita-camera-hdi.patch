@@ -125,29 +125,41 @@ root {
                 ];
             }
         }
+        /*
+         * OnePlus 6 rear camera: Sony IMX376K on CSIPHY1, raw Bayer through Qualcomm CAMSS (no ISP),
+         * converted to YUV in software by the V4L2 adapter (camss_raw.cfg). lcam001 -> CAMERA_FIRST ->
+         * hardware "imx376" (device_manager/include/project_hardware.h).
+         * For a BUILTIN camera the VDI drops OHOS_ABILITY_STREAM_AVAILABLE_EXTEND_CONFIGURATIONS
+         * (camera_host_vdi_impl.cpp GetCameraAbility), so the profiles the framework offers come only
+         * from basicAvailableConfigurations: triplets {format, width, height}, format = 1-based index into
+         * formatArray (metadata_enum_map.h): 1 RGBA_8888, 2 YCBCR_420_888 (ignored by the framework),
+         * 3 YCRCB_420_SP (NV21), 4 JPEG. Non-JPEG entries become preview profiles and, combined with each
+         * availableFpsRange pair, video profiles; JPEG entries become photo profiles.
+         * Sizes: 2x2-binned sensor (2592x1940 -> 1296x970) scaled to 4:3; keep them <= 1296x970 until the
+         * software path has a full-resolution demosaic.
+         */
         ability_01 :: ability {
             logicCameraId = "lcam001";
             physicsCameraIds = [
-                "CAMERA_FIRST",
-                "CAMERA_SECOND"
+                "CAMERA_FIRST"
             ];
             metadata {
                 aeAvailableAntiBandingModes = [
                     "OHOS_CAMERA_AE_ANTIBANDING_MODE_OFF"
                 ];
-                aeAvailableModes = ["OHOS_CAMERA_AE_MODE_OFF"];
-                availableFpsRange = [5, 10];
-                cameraPosition = "OHOS_CAMERA_POSITION_FRONT";
+                aeAvailableModes = ["OHOS_CAMERA_AE_MODE_ON"];
+                availableFpsRange = [15, 30];
+                cameraPosition = "OHOS_CAMERA_POSITION_BACK";
                 cameraType = "OHOS_CAMERA_TYPE_WIDE_ANGLE";
                 cameraConnectionType ="OHOS_CAMERA_CONNECTION_TYPE_BUILTIN";
-                cameraMemoryType ="OHOS_CAMERA_MEMORY_USERPTR";
+                cameraMemoryType ="OHOS_CAMERA_MEMORY_MMAP";
                 faceDetectMaxNum = "10";
                 aeCompensationRange = [0, 0];
                 aeCompensationSteps = [0, 0];
                 availableAwbModes = [
-                    "OHOS_CAMERA_AWB_MODE_OFF"
+                    "OHOS_CAMERA_AWB_MODE_AUTO"
                 ];
-                sensitivityRange = [32, 2400];
+                sensitivityRange = [100, 1600];
                 faceDetectMode = "OHOS_CAMERA_FACE_DETECT_MODE_OFF";
                 availableCharacteristicsKeys = [
                     "OHOS_CONTROL_AE_AVAILABLE_ANTIBANDING_MODES",
@@ -181,6 +193,8 @@ root {
                     "OHOS_JPEG_ORIENTATION"
                 ];
                 focalLength = "24.0";
+                /* mode lists as on rk3568 (the reference the system Camera app is tested on);
+                   the HDI accepts and ignores them: no AF/flash/manual exposure on this path */
                 focusAvailableModes = [
                     "OHOS_CAMERA_FOCUS_MODE_MANUAL",
                     "OHOS_CAMERA_FOCUS_MODE_CONTINUOUS_AUTO",
@@ -205,9 +219,8 @@ root {
