+static int32_t ParseHvccSize(const uint8_t *data, int32_t size)
+{
+    if (data == nullptr || size < 23) {
+        return -1;
+    }
+    if (data[0] != 0x01) { // configurationVersion must be 1
+        return -1;
+    }
+    int32_t offset = 22; // HVCC header is 23 bytes (0-22)
+    uint8_t numOfArrays = data[offset];
+    offset++;
+    for (uint8_t i = 0; i < numOfArrays; i++) {
+        if (offset + 3 > size) {
+            return -1;
+        }
+        offset++; // array_completeness | NAL_unit_type
+        uint16_t numNalus = (data[offset] << 8) | data[offset + 1];
+        offset += 2;
+        for (uint16_t j = 0; j < numNalus; j++) {
+            if (offset + 2 > size) {
+                return -1;
+            }
+            uint16_t nalUnitLength = (data[offset] << 8) | data[offset + 1];
+            offset += 2 + nalUnitLength;
+            if (offset > size) {
+                return -1;
+            }
+        }
+    }
+    return offset;
+}
