media: OnePlus 6 camera sensors (IMX519, IMX376K, IMX371) and lens drivers (backport, 5.10)

Sensor drivers from the sdm845-mainline tree (codeberg.org/sdm845/linux, sdm845-next): Sony IMX519 (rear
main, MIPI C-PHY), IMX376K (rear secondary) and IMX371 (front), and the LC898217XC lens voice coil driver
(lc89821x), with the helpers they need that 5.10 lacks: v4l2-cci (CCI register helpers, module
v4l2-cci.ko, upstream since 6.7) and the CCS register definitions (drivers/media/i2c/ccs/ccs-regs.h).
v4l2-compat-5.10.h maps the newer subdev API onto 5.10 (subdev state -> pad config,
v4l2_link_freq_to_bitmap, i2c_get_match_data); the drivers use .probe_new and int .remove.
All are modules (CONFIG_VIDEO_IMX371/IMX376/IMX519/LC89821X=m, V4L2_CCI selected as m).

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 878f66ef2..4d7aeaa55 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -825,6 +825,48 @@ config VIDEO_IMX355
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx355.
 
+config VIDEO_IMX371
+	tristate "Sony IMX371 sensor support"
+	depends on I2C && VIDEO_V4L2 && OF
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_FWNODE
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX371 camera (OnePlus 6/6T front camera).
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx371.
+
+config VIDEO_IMX376
+	tristate "Sony IMX376 sensor support"
+	depends on I2C && VIDEO_V4L2 && OF
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_FWNODE
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX376 camera (OnePlus 6/6T secondary rear camera).
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx376.
+
+config VIDEO_IMX519
+	tristate "Sony IMX519 sensor support"
+	depends on I2C && VIDEO_V4L2 && OF
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_FWNODE
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony
+	  IMX519 camera (OnePlus 6/6T main rear camera).
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx519.
+
 config VIDEO_OV2640
 	tristate "OmniVision OV2640 sensor support"
 	depends on VIDEO_V4L2 && I2C
@@ -1303,6 +1345,18 @@ config VIDEO_DW9807_VCM
 	  capability. This is designed for linear control of
 	  voice coil motors, controlled via I2C serial interface.
 
+config VIDEO_LC89821X
+	tristate "LC89821X lens voice coil support"
+	depends on I2C && VIDEO_V4L2 && OF
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_CCI_I2C
+	help
+	  This is a driver for the LC898217XC and LC898219XI camera lens
+	  voice coils. They are 11 and 12 bit DACs with 110mA and 140mA
+	  output current sink capability. This is designed for linear
+	  control of voice coil motors, controlled via I2C serial interface.
+
 endmenu
 
 menu "Flash devices"
