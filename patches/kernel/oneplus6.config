# Added on top of sdm845_ohos_defconfig (merged by scripts/04-build-kernel.sh).
# Large console font: with console=tty0 the boot log is readable on the 1080x2280 panel.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# Cameras (patches 0005-0007): the SDM845 camera subsystem, the OnePlus 6 sensors and lens drivers. All modules,
# so the built-in kernel (and with it every module ABI) stays the same as without them.
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_IMX371=m
CONFIG_VIDEO_IMX376=m
CONFIG_VIDEO_IMX519=m
CONFIG_VIDEO_LC89821X=m
