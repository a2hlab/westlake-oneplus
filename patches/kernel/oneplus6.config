# Added on top of sdm845_ohos_defconfig (merged by scripts/04-build-kernel.sh).
# Large console font: with console=tty0 the boot log is readable on the 1080x2280 panel.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# Lockup reports: a CPU stuck in the kernel (soft lockup) or a stalled workqueue is logged to the printk ring, which
# the crash-dump capture (main branch, scripts/crashdump.py kmsg) reads after a hang. Reporting only, no panic.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_WQ_WATCHDOG=y
