sdm845-oneplus-enchilada: add the qcom,msm-id/board-id the OnePlus 6 bootloader reports
(read from the stock device tree: msm-id <0x141 0x20001>, board-id <8 0 0x459b 0x16>).

diff --git a/arch/arm64/boot/dts/qcom/sdm845-oneplus-enchilada.dts b/arch/arm64/boot/dts/qcom/sdm845-oneplus-enchilada.dts
index 83b5fdb32..3d948bd4a 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-oneplus-enchilada.dts
+++ b/arch/arm64/boot/dts/qcom/sdm845-oneplus-enchilada.dts
@@ -10,6 +10,8 @@
 / {
 	model = "OnePlus 6";
 	compatible = "oneplus,enchilada", "qcom,sdm845";
+	qcom,msm-id = <0x141 0x20001>;
+	qcom,board-id = <8 0 0x459b 0x16>;
 };
 
